---
import '../styles/global.css';

const {
  title,
  description = 'Ideas y recomendaciones para crear rincones cálidos en casa.'
} = Astro.props;

const pageTitle = `${title} · The Cozy Nest`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navLink = (path) =>
  `hover:text-terracotta ${currentPath.startsWith(path) ? 'text-terracotta' : ''}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body class="font-sans">
  <header class="border-b border-borderc py-6">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 flex flex-wrap gap-4 justify-between items-center">
      <a href="/" class="font-serif text-2xl font-medium text-burgundy">
        The Cozy<span class="text-mustard-dark">Nest</span>
      </a>
      <nav class="flex gap-5 sm:gap-7 text-sm font-medium text-ink-soft">
        <a href="/oficina-cozy" class={navLink('/oficina-cozy')}>Oficina cozy</a>
        <a href="/rincon-lectura" class={navLink('/rincon-lectura')}>Rincón de lectura</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-borderc py-9 mt-16">
    <div class="max-w-xl mx-auto px-8 text-center">
      <p class="text-xs text-ink-soft">
        Como afiliado de Amazon, realizo compras adscritas que cumplen los requisitos aplicables.
      </p>
    </div>
  </footer>
</body>
</html>
