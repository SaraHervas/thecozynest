---
const { badge, title, description, href } = Astro.props;
---
<a
  href={href}
  class="block bg-paper border border-borderc/60 rounded-3xl p-8 shadow-cozy hover:shadow-cozy-lg hover:-translate-y-1 transition-all duration-300"
>
  {badge && (
    <span class="inline-block bg-cream-2 text-terracotta text-xs font-semibold px-3 py-1.5 rounded-full mb-4">
      {badge}
    </span>
  )}
  <h3 class="font-serif text-xl text-burgundy-dark font-medium mb-2">{title}</h3>
  <p class="text-ink-soft text-sm mb-4">{description}</p>
  <span class="text-terracotta font-semibold text-sm">Leer guía →</span>
</a>
