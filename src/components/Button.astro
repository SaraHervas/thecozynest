---
const { href, class: className = '' } = Astro.props;
---
<a
  href={href}
  class={`inline-block bg-mustard hover:bg-mustard-dark transition-all duration-300 ease-out text-cream font-semibold px-8 py-3.5 rounded-full shadow-cozy hover:shadow-cozy-lg hover:-translate-y-0.5 hover:scale-[1.03] active:scale-[0.98] ${className}`}
>
  <slot />
</a>
