---
const { productos, columnaDestacado = 'Ideal para' } = Astro.props;
---
<div class="overflow-x-auto mb-12">
  <table class="w-full text-sm border border-borderc/60 rounded-2xl overflow-hidden shadow-cozy bg-paper">
    <thead>
      <tr class="bg-cream-2 text-left">
        <th class="p-4 font-medium text-burgundy-dark">Modelo</th>
        <th class="p-4 font-medium text-burgundy-dark">{columnaDestacado}</th>
        <th class="p-4 font-medium text-burgundy-dark">Precio orientativo</th>
      </tr>
    </thead>
    <tbody>
      {productos.map((p) => (
        <tr class="border-t border-borderc/60">
          <td class="p-4">{p.nombre}</td>
          <td class="p-4 text-ink-soft">{p.destacado}</td>
          <td class="p-4 text-ink-soft">{p.precio}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
