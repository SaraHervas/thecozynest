---
import Button from './Button.astro';

const {
  eyebrow = 'Guías de estilo de vida cálido',
  title = 'Rincones que dan ganas de quedarse en casa',
  description = 'Ideas y recomendaciones para convertir tu escritorio y tu sillón de lectura en el lugar favorito de tu piso, aunque sea pequeño.',
  ctaHref = '/oficina-cozy',
  ctaLabel = 'Ver guía de oficina cozy'
} = Astro.props;
---
<section class="relative overflow-hidden">
  <!-- profundidad: manchas de color muy difuminadas, decorativas -->
  <div class="pointer-events-none absolute -top-24 -right-16 w-[26rem] h-[26rem] rounded-full bg-terracotta/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-20 w-[22rem] h-[22rem] rounded-full bg-sage/20 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/4 left-1/2 w-72 h-72 rounded-full bg-mustard/10 blur-3xl"></div>

  <div class="relative max-w-6xl mx-auto px-6 sm:px-8 min-h-[85vh] flex items-center">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-6 items-center w-full py-16">
      <div class="lg:col-span-7">
        <p class="text-sage text-sm font-medium tracking-[0.15em] uppercase mb-6">{eyebrow}</p>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-[4.5rem] font-medium text-burgundy-dark leading-[1.05] tracking-tight mb-7 max-w-xl">
          {title}
        </h1>
        <p class="text-ink-soft text-lg max-w-md mb-10 leading-relaxed">
          {description}
        </p>
        <Button href={ctaHref}>{ctaLabel}</Button>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative bg-gradient-to-br from-cream-2 to-cream border border-borderc/50 rounded-[2.5rem] shadow-cozy-lg aspect-[4/4.6] flex items-center justify-center lg:translate-y-4 hover:-translate-y-1 hover:shadow-[0_30px_70px_-20px_rgba(46,33,28,0.3)] transition-all duration-500 ease-out">
          <span class="text-ink-soft text-sm px-10 text-center">Espacio para imagen o ilustración</span>
        </div>
        <div class="hidden lg:block absolute -bottom-6 -left-10 w-36 h-24 bg-paper border border-borderc/50 rounded-3xl shadow-cozy"></div>
      </div>
    </div>
  </div>
</section>
