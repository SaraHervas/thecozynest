---
import { withAffiliateTag } from '../lib/affiliate.js';

const { href, label = 'Ver precio en Amazon' } = Astro.props;
const finalHref = withAffiliateTag(href);
---
<a
  href={finalHref}
  target="_blank"
  rel="nofollow noopener noreferrer"
  class="btn-press inline-block bg-mustard text-cream font-semibold px-6 py-2.5 rounded-full text-sm"
>
  {label}
</a>
