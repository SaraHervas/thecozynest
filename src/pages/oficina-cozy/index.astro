---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

// Recoge automáticamente todos los artículos .astro de esta carpeta,
// excepto index.astro y cualquier archivo que empiece por "_" (plantillas).
const modules = import.meta.glob('./*.astro', { eager: true });

const articulos = Object.entries(modules)
  .filter(([path]) => !path.endsWith('/index.astro') && !path.includes('/_'))
  .map(([, mod]) => mod.meta)
  .filter(Boolean);
---
<Layout title="Oficina cozy" description="Guías y recomendaciones para un home office cálido y funcional.">
  <section class="max-w-5xl mx-auto px-8 py-16">
    <h1 class="font-serif text-4xl text-burgundy-dark font-medium mb-3">Oficina cozy</h1>
    <p class="text-ink-soft max-w-lg mb-10">
      Todo lo que necesitas para montar un rincón de teletrabajo cálido y bonito:
      escritorio, silla, gestión de cables, alfombras, lámparas y esos detalles
      que hacen que un despacho se sienta acogedor.
    </p>

    {articulos.length > 0 ? (
      <div class="grid sm:grid-cols-2 gap-7">
        {articulos.map((a) => (
          <ArticleCard title={a.title} description={a.description} badge={a.badge} href={a.href} imagen={a.imagen} />
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-soft italic">Contenido pendiente de añadir.</p>
    )}
  </section>
</Layout>
