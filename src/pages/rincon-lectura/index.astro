---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const modules = import.meta.glob('./*.astro', { eager: true });
const articulos = Object.values(modules)
  .filter((m) => m.meta)
  .map((m) => m.meta);
---
<Layout title="Rincón de lectura" description="Ideas para crear un rincón de lectura acogedor en casa.">
  <section class="max-w-3xl mx-auto px-8 py-16">
    <h1 class="font-serif text-4xl text-burgundy-dark font-medium mb-4">Rincón de lectura</h1>
    <p class="text-ink-soft mb-10">
      Sillones pequeños, lámparas de pie, mantas suaves y atriles para tu esquina
      de lectura favorita.
    </p>

    {articulos.length > 0 ? (
      <div class="grid sm:grid-cols-2 gap-6">
        {articulos.map((a) => <ArticleCard {...a} />)}
      </div>
    ) : (
      <p class="text-sm text-ink-soft italic">Contenido pendiente de añadir.</p>
    )}
  </section>
</Layout>
