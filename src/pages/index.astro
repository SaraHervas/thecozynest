---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Inicio">
  <section class="max-w-5xl mx-auto px-8 py-16 grid md:grid-cols-2 gap-14 items-center">
    <div>
      <p class="text-sage text-sm font-medium mb-3">Guías de estilo de vida cálido</p>
      <h1 class="font-serif text-4xl md:text-5xl font-medium text-burgundy-dark leading-tight mb-5 max-w-md">
        Rincones que dan ganas de quedarse en casa
      </h1>
      <p class="text-ink-soft max-w-sm mb-7">
        Ideas y recomendaciones para convertir tu escritorio y tu sillón de lectura
        en el lugar favorito de tu piso, aunque sea pequeño.
      </p>
      <a href="/oficina-cozy" class="btn-press inline-block bg-mustard text-cream font-semibold px-7 py-3 rounded-full">
        Ver guía de oficina cozy
      </a>
    </div>
    <div class="bg-cream-2 border border-borderc rounded-3xl aspect-[4/3.4] flex items-center justify-center relative overflow-hidden">
      <img
        src="/images/imagen_principal.jpg"
        alt="Rincón de oficina cozy"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <span class="mote absolute w-1.5 h-1.5 rounded-full bg-mustard" style="left:38%; bottom:35%; --drift-x:14px; animation-delay:0s;"></span>
      <span class="mote absolute w-1 h-1 rounded-full bg-mustard" style="left:52%; bottom:32%; --drift-x:-10px; animation-delay:1.8s;"></span>
      <span class="mote absolute w-1 h-1 rounded-full bg-terracotta" style="left:60%; bottom:38%; --drift-x:8px; animation-delay:3.4s;"></span>
      <span class="mote absolute w-1.5 h-1.5 rounded-full bg-mustard" style="left:45%; bottom:30%; --drift-x:-6px; animation-delay:5s;"></span>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-8 py-14">
    <h2 class="font-serif text-3xl text-burgundy-dark font-medium mb-2">Dos rincones, un mismo espíritu</h2>
    <p class="text-ink-soft max-w-md mb-9">
      Contenido pensado para pisos reales, presupuestos reales y teletrabajo real.
    </p>
    <div class="grid md:grid-cols-2 gap-7">
      <a href="/oficina-cozy" class="card-lift block bg-white border border-borderc rounded-3xl p-8">
        <span class="inline-block bg-cream-2 text-terracotta text-xs font-semibold px-2.5 py-1 rounded-full mb-4">Pilar 1</span>
        <h3 class="font-serif text-xl text-burgundy-dark font-medium mb-2">Oficina cozy</h3>
        <p class="text-ink-soft text-sm mb-4">
          Lámparas cálidas, sillas con estilo, organizadores bonitos y mantas para tu silla de teletrabajo.
        </p>
        <span class="text-terracotta font-semibold text-sm">Explorar oficina cozy <span class="arrow-shift">→</span></span>
      </a>
      <a href="/rincon-lectura" class="card-lift block bg-white border border-borderc rounded-3xl p-8">
        <span class="inline-block bg-cream-2 text-terracotta text-xs font-semibold px-2.5 py-1 rounded-full mb-4">Pilar 2</span>
        <h3 class="font-serif text-xl text-burgundy-dark font-medium mb-2">Rincón de lectura</h3>
        <p class="text-ink-soft text-sm mb-4">
          Sillones pequeños, lámparas de pie, mantas suaves y atriles para tu esquina de lectura favorita.
        </p>
        <span class="text-terracotta font-semibold text-sm">Explorar rincón de lectura <span class="arrow-shift">→</span></span>
      </a>
    </div>
  </section>
</Layout>
